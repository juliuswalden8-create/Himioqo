# Public site origin for canonical URLs, Open Graph, sitemap and QR links.
# Leave empty until a custom domain is connected — production then falls back
# to the Vercel URL. Prefer this over guessing a domain name in code.
NEXT_PUBLIC_SITE_URL=
# Alias still accepted if SITE_URL is empty.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Paste the Google Search Console verification code to prove ownership.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. GA4 Measurement ID (G-XXXXXXXX). Loads official gtag.js in <head>
# so Google can verify site ownership. Leave empty to skip. Set the same value on Vercel.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required in production. Signs the session cookie so it cannot be forged.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. If empty, Homioqo runs on realistic in-memory demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Inbox for demo, signup and QR-order notices. Defaults to the founder Gmail.
ADMIN_EMAIL=juliuswalden8@gmail.com

# Optional. Required in production to actually send the verification email
# and founder notices. If empty, notices are only logged in the server output
# (Vercel → Logs).
RESEND_API_KEY=
RESEND_FROM=Homioqo <hej@homioqo.se>

# Optional. Invite SMS via Twilio REST. If any of these is empty, SMS is not
# sent and the host gets a copyable invite URL instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional. If empty, a mock translation service is used.
DEEPL_API_KEY=
