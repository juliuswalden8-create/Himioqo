NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production. Signs the session cookie so it cannot be forged.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional. If empty, Homioqo runs on realistic in-memory demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still accepted if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If empty, emails are logged but not sent.
RESEND_API_KEY=
RESEND_FROM=Homioqo <hej@homioqo.se>

# Optional. If empty, a mock translation service is used.
DEEPL_API_KEY=
